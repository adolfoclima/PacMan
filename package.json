    "format:check": "prettier --check src package.json vite.config.js eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vite": "^8.3.6",
    "vitest": "^4.0.13"
  }
}
